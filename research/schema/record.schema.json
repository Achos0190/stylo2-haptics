{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Achos0190/stylo2-haptics/research/schema/record.schema.json",
  "title": "Stylus haptics research record",
  "description": "One entry in research/data/<type>s.json. research/tools/validate.py enforces the same rules without needing a JSON Schema library.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "title", "vendor", "category", "status", "priority", "url", "links", "summary", "details", "tags", "related", "basis", "updated"],
  "properties": {
    "id": {
      "description": "Stable slug. Prefix by type: source = src- or repo-, device = dev-, interface = if-, concept = c-, plan = plan-, gap = gap-.",
      "type": "string",
      "pattern": "^(src|repo|dev|if|c|plan|gap)-[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "type": { "enum": ["source", "device", "interface", "concept", "plan", "gap"] },
    "title": { "type": "string", "minLength": 1 },
    "vendor": {
      "type": "string",
      "minLength": 1,
      "description": "Grouping, for example OnePlus, Xiaomi, Android, Microsoft, USB-IF, Bluetooth, Cross-vendor."
    },
    "category": { "type": "string" },
    "status": {
      "description": "verified: checked against a primary source. unverified: not yet checked. inferred: reasoned from verified facts. open: unknown.",
      "enum": ["verified", "unverified", "inferred", "open"]
    },
    "priority": { "enum": ["critical", "high", "medium", "low"] },
    "url": {
      "description": "Main link, or an empty string.",
      "type": "string",
      "pattern": "^(https?://.+)?$"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string" },
          "url": { "type": "string", "pattern": "^https?://.+" }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "details": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
    },
    "related": {
      "description": "IDs of other records. Every ID must exist.",
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "basis": {
      "description": "Where the content came from and when it was checked.",
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "description": "Date the record last changed (YYYY-MM-DD).",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
