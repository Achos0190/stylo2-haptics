<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared so the app CAN hold it if the platform ever grants it. The PoC
         does not assume it is granted; it attempts the bind regardless and
         reports what happens. -->
    <uses-permission android:name="com.oplus.permission.safe.IOT" />

    <queries>
        <package android:name="com.oplus.ipemanager" />
        <intent>
            <action android:name="com.oplus.ipemanager.ACTION.PENCIL_SDK" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
